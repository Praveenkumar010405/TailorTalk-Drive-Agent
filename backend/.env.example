GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json

# Optional: restrict searches to one direct Google Drive folder.
# Leave blank to search every file visible to the service account.
GOOGLE_DRIVE_FOLDER_ID=

# Optional: change the Gemini model without editing code.
GEMINI_MODEL=gemini-2.5-flash
